# Local build target: the app is served BY the local backend on :8080, so it
# must talk to that same backend. `npm run deploy` uses .env.production (the
# Render load-balanced list) and is for the real deployment — use
# `npm run deploy:local` when testing on this machine.
VITE_API_URL=http://localhost:8080
VITE_SIGNALING_URL=http://localhost:8080
