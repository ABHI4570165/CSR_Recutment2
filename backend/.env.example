# ── Copy to .env and fill in real values. NEVER commit the real .env. ──
PORT=8080
NODE_ENV=production
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
ADMIN_JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional read-only VIEWER login (sees the dashboard, cannot create/edit/delete).
VIEWER_USERNAME=
VIEWER_PASSWORD=
# Browser origins allowed to call this backend (CORS).
# MULTIPLE ORIGINS ARE COMMA-SEPARATED in this one variable — there is no
# FRONTEND_URL_2 and no FRONTEND_URLS. Surrounding quotes, spaces around the
# commas and trailing slashes are tolerated, but plain values are clearest.
# localhost:5173 and :4173 are always allowed and need not be listed.
#
# EVERY backend must list EVERY front-end domain: the client-side load balancer
# retries the same request against each backend, so one instance that omits an
# origin fails the whole request as soon as failover reaches it.
FRONTEND_URL=https://assessment.mandi-hariyanna-academy.com,https://testportal.mandi-hariyanna-academy.com
# The ONE address put into links people click (assessment invitation, email logo).
# Defaults to the FIRST entry of FRONTEND_URL above. Set this only if candidates
# should be sent somewhere other than that first domain. Never a list.
# PUBLIC_APP_URL=https://assessment.mandi-hariyanna-academy.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Email (Brevo SMTP) ──────────────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_BATCH_SIZE=25
EMAIL_MAX_ATTEMPTS=3

# ── Cloudinary (walk-in resume storage) ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mh_resumes

# ── Mongo connection pool ───────────────────────────────
MONGO_POOL_SIZE=20
MONGO_MIN_POOL=2

# ── Optional ────────────────────────────────────────────
# BREVO_API_KEY=        # xkeysib-... use Brevo HTTPS API if SMTP port 587 is blocked
# WHATSAPP_GROUP_URL=   # overrides the WhatsApp group link in the thank-you email
# REDIS_URL=            # leave blank on Hostinger — caching falls back to DB automatically

# ── Local AI evaluation worker ──────────────────────────────────────
# Shared secret between the production API and the worker on your machine.
# NOT the admin JWT: it lives in a file on a laptop, so it must be rotatable on
# its own and must not grant admin access if it leaks. Leave unset and the
# evaluation endpoints stay closed rather than defaulting to open.
EVALUATOR_API_KEY=
# Where the worker posts back to (set on the WORKER, not the server).
API_BASE_URL=https://csr-recutment2.onrender.com
# Ollama, on the worker machine only. The production server never calls this.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
