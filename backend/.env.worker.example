# ═══════════════════════════════════════════════════════════════════
#  LOCAL EVALUATION WORKER  —  belongs on YOUR MACHINE ONLY
#
#  Copy to backend/.env on the machine that runs Ollama, then:
#      npm run evaluation:worker
#
#  NOTHING in this file belongs on Render. The production server never
#  calls Ollama, so it has no use for any OLLAMA_* value — and
#  http://localhost:11434 on Render is the Render container, not this
#  machine, so setting it there would point at nothing.
#
#  Connection direction, both outbound from here:
#      this machine  ──HTTPS──>  Render API
#      this machine  ──HTTP───>  Ollama on this same machine
#  Render never connects back. No port needs to be exposed.
# ═══════════════════════════════════════════════════════════════════

# Where to pull pending answers from and post marks back to.
API_BASE_URL=https://csr-recutment2.onrender.com

# Shared secret, identical to the one set on Render.
# This authenticates THIS WORKER TO RENDER. It is NOT an Ollama key —
# Ollama has no key. Do not paste an AI provider key here.
EVALUATOR_API_KEY=

# Local Ollama. Never exposed, never reachable from the internet.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional pacing.
EVAL_POLL_MS=8000     # how often to look for work while the queue is empty
EVAL_BATCH=5          # answers leased per round trip

# The worker also needs MONGO_URI only if you run it from a full backend
# checkout that loads other modules; evaluation itself goes through the API.
