# Dependencies
node_modules/
*/node_modules/

# Build output
frontend/dist/
frontend/.env.production
backend/client/

# Deploy artifacts (zips + extracted builds) — generated, not source
*.zip
mha-frontend/
mha-fullstack/
archive/

# Screen recordings / demo videos — large binaries, not source
reference/

# Candidate data, generated reports and exam papers. NEVER commit these:
# the link sheets carry live assessment tokens (the token IS the credential),
# the reports carry candidate names, and papers/ holds the answer keys.
assets/
# Migration dry-run output — candidate names, emails, phone numbers and scores.
# The scripts themselves ARE source and stay tracked.
backend/scripts/migrations/out/

# Source questionnaires kept at the repo root (they contain answer keys).
# Seeded into the DB by backend/scripts/seed*.js — move them under assets/ to file them away.
/*.pdf
/*.docx

# Load-test generated results (scripts + REPORT.md are kept)
loadtest/*-results.json
loadtest/full-flow-summary.json

# Environment secrets — NEVER commit these.
# The wildcards matter: `backend/.env` alone does NOT cover .env.backup-…,
# .env.local or .env.save, and a copy of a secrets file is still a secrets file.
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.worker.example
*.env.backup*
# Local dev frontend env (localhost) — must NOT override Vercel/Hostinger build config
frontend/.env

# Claude Code local project data (memory, sessions)
.claude/

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# PM2
.pm2/

# Editor
.vscode/
.idea/

# Temporary DOCX extraction (round-2 import)
.docx_tmp/
